---
import '../styles/global.css';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://piuraplazadearmas.com';
const canonical = Astro.site ? new URL('/', Astro.site).href : undefined;

const attractionFullName = 'Plaza de Armas Piura';
const attractionShortName = 'Plaza de Armas de Piura';
const cityName = 'Piura';
const stateProvince = 'Piura';
const countryName = 'Perú';
const countryCode = 'PE';
const postalCode = '20001';
const plusCode = 'R93F+58';
const latitude = -5.1970998;
const longitude = -80.62668;

const mapShortUrl = 'https://maps.app.goo.gl/WAjRRUEwGccZYiKd9';
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7067.300021221717!2d-80.6292602874832!3d-5.197099794758691!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x904a107ddd0efae7%3A0xaeb976088d0ea599!2sPlaza%20de%20Armas%20Piura!5e1!3m2!1ses!2spe!4v1789026773647!5m2!1ses!2spe';

const govtTourismUrl = 'https://www.gob.pe/munipiura';
const govtTourismPortalUrl = 'http://turismo.munipiura.gob.pe/';
const minceturFicha = 'https://consultasenlinea.mincetur.gob.pe/fichaInventario/index.aspx?cod_Ficha=3163';
const peruTravelUrl = 'https://www.peru.travel/es';
const mucenUrl = 'https://mucen.bcrp.gob.pe/mucen/museos/mucen-piura';
const casaMuseoUrl = 'https://museos.cultura.pe/museos/casa-museo-gran-almirante-grau-de-piura';

const title = `${attractionFullName} (${cityName}, ${countryName}) - Guía y ubicación`;
const description = `Guía de la ${attractionFullName} (${countryName}): mapa, acceso libre todo el año, historia de "La Pola", la Catedral de San Miguel Arcángel y qué ver alrededor.`;
const ogImage = `${siteUrl}/images/plaza-de-armas-piura-hero.jpg`;
const ogImageAlt = `${attractionFullName} - vista principal en ${cityName}, ${countryName}`;
const ogImageWidth = 1280;
const ogImageHeight = 866;

const dateModified = '2026-09-10';

const photos = {
  hero: {
    src: '/images/plaza-de-armas-piura-hero.jpg',
    alt: `${attractionFullName} - vista principal en ${cityName}, ${countryName}`,
    credit: 'Edward Josué Quevedo Macalupú · CC BY-SA 4.0',
    page: 'https://commons.wikimedia.org/wiki/File:PLAZA_DE_ARMAS_DE_PIURA_-_PIURA.jpg',
  },
  square: {
    src: '/images/plaza-de-armas-piura-vista.jpg',
    alt: `Jardines, bancas y entorno urbano de la ${attractionShortName} en ${cityName}`,
    credit: 'Pitxiquin · CC BY-SA 4.0',
    page: 'https://commons.wikimedia.org/wiki/File:Plaza_de_Armas_de_Piura.jpg',
  },
  cathedral: {
    src: '/images/catedral-de-piura.jpg',
    alt: `Catedral de San Miguel Arcángel junto a la ${attractionShortName}, ${cityName}, ${countryName}`,
    credit: 'Edward Josué Quevedo Macalupú · CC BY-SA 4.0',
    page: 'https://commons.wikimedia.org/wiki/File:CATEDRAL_DE_PIURA_-_PIURA.jpg',
  },
  monument: {
    src: '/images/alegoria-a-la-libertad.jpg',
    alt: `Alegoría a la Libertad, monumento central de la ${attractionShortName}, ${cityName}, ${countryName}`,
    credit: 'Ccotlear · CC BY-SA 4.0',
    page: 'https://commons.wikimedia.org/wiki/File:ALEGORIA_A_LA_LIBERTAD.jpg',
  },
};

const facts = [
  { label: 'Nombre oficial', value: attractionShortName },
  { label: 'Categoría', value: 'Parque urbano (city park)' },
  { label: 'Ubicación', value: `Ayacucho, ${cityName} ${postalCode}, ${countryName}` },
  { label: 'Plus Code', value: `${plusCode}, ${cityName}` },
  { label: 'Coordenadas', value: `${latitude.toFixed(5)}, ${longitude.toFixed(5)}` },
  { label: 'Horario', value: 'Acceso libre las 24 horas' },
  { label: 'Entrada', value: 'Libre' },
  { label: 'Altitud', value: '22 m s. n. m.' },
  { label: 'Calificación', value: '4,3 · 16.985 reseñas de Google' },
];

const visitCards = [
  {
    icon: 'S/',
    title: 'Entrada y costo',
    text: 'El acceso a la plaza es libre. No hay boleto de ingreso para recorrer este espacio público.',
  },
  {
    icon: '◴',
    title: 'Mejor momento',
    text: 'La mañana temprana y el final de la tarde suelen dar una caminata más amable por el calor piurano y mejor luz para fotografías.',
  },
  {
    icon: '↻',
    title: 'Tiempo sugerido',
    text: 'Reserva 30–60 minutos para la plaza; calcula 2–3 horas si la combinas con la catedral, MUCEN y calles del centro histórico.',
  },
  {
    icon: 'P',
    title: 'Estacionamiento',
    text: 'El centro tiene cocheras privadas y estacionamiento limitado en calle. Conviene llegar con margen y confirmar tarifa y disponibilidad en el momento.',
  },
];

const foods = [
  {
    name: 'El Chalán · Plaza de Armas',
    type: 'Café, helados y pausa rápida',
    text: 'En la misma zona de la plaza; práctico para refrescarse antes de seguir caminando por el centro.',
    address: 'Calle Tacna 520–526',
  },
  {
    name: 'La Tomasita',
    type: 'Cocina norteña tradicional',
    text: 'Una opción conocida para probar sabores de Piura a pocas cuadras del núcleo histórico.',
    address: 'Centro de Piura',
  },
  {
    name: 'Restaurante La Blanca',
    type: 'Cocina piurana',
    text: 'Alternativa de comida local dentro del centro para completar la visita con platos regionales.',
    address: 'Jr. Arequipa 1240',
  },
];

const nearby = [
  {
    distance: 'frente a la plaza',
    name: 'Catedral de San Miguel Arcángel',
    text: 'Templo principal del centro histórico —también conocido como Iglesia Matriz— y uno de los elementos que define la imagen urbana de la plaza.',
  },
  {
    distance: 'frente a la plaza',
    name: 'MUCEN Piura',
    text: 'Museo del Banco Central de Reserva con colecciones que ayudan a leer la historia y cultura regional. Ingreso por la calle Huancavelica 346.',
  },
  {
    distance: 'a pasos',
    name: 'Municipalidad Provincial de Piura',
    text: 'Edificio cívico que preside uno de los laterales de la plaza y que gestiona el centro de la ciudad.',
  },
  {
    distance: 'caminata corta',
    name: 'Casa Museo Gran Almirante Grau',
    text: 'Casa vinculada a Miguel Grau, figura central de la historia peruana y uno de los puntos culturales de Piura. Ubicada en el Jirón Tacna 662.',
  },
  {
    distance: 'cerca del centro',
    name: 'Iglesia San Sebastián',
    text: 'Otra parada religiosa e histórica que se integra bien a un circuito peatonal por el casco antiguo.',
  },
];

const sources = [
  { name: 'MINCETUR — Inventario Nacional de Recursos Turísticos', detail: 'Ficha N.º 3163: Plaza De Armas De Piura', url: minceturFicha },
  { name: 'Gob.pe — Municipalidad Provincial de Piura', detail: 'Información institucional y datos del turismo local', url: govtTourismUrl },
  { name: 'Portal Turístico de Piura', detail: 'Promoción oficial del departamento de Piura', url: govtTourismPortalUrl },
  { name: 'Perú Travel', detail: 'Portal Oficial de Turismo del Perú (PROMPERÚ)', url: peruTravelUrl },
  { name: 'Ministerio de Cultura', detail: 'Casa Museo Gran Almirante Grau de Piura', url: casaMuseoUrl },
  { name: 'Banco Central de Reserva del Perú', detail: 'MUCEN Piura', url: mucenUrl },
  { name: 'Google Maps', detail: 'Plaza de Armas Piura', url: mapShortUrl },
];

const faqs = [
  {
    q: '¿La Plaza de Armas de Piura cobra entrada?',
    a: 'No. Es un espacio público de acceso libre. Los museos, templos o servicios cercanos pueden manejar sus propias condiciones y horarios.',
  },
  {
    q: '¿La plaza está abierta todo el día?',
    a: 'La ficha pública del lugar la muestra con acceso las 24 horas. Para una visita turística cómoda, es preferible ir con luz de día y revisar por separado los horarios de museos y comercios cercanos.',
  },
  {
    q: '¿Cuánto tiempo necesito para visitarla?',
    a: 'Para recorrer la plaza y observar el monumento central suelen bastar entre 30 y 60 minutos. Si sumas la catedral, museos y una comida en el centro, reserva de 2 a 3 horas.',
  },
  {
    q: '¿Qué hay en el centro de la plaza?',
    a: 'Se encuentra la Alegoría a la Libertad, conocida localmente como “La Pola”, un monumento histórico de mármol asociado a la identidad del espacio cívico piurano.',
  },
  {
    q: '¿Qué puedo visitar caminando desde la plaza?',
    a: 'La Catedral de San Miguel Arcángel, MUCEN Piura y varias calles del centro histórico están inmediatamente alrededor o a pocos minutos a pie; la Casa Museo Gran Almirante Grau también queda dentro de un circuito céntrico razonable.',
  },
  {
    q: '¿Dónde conviene estacionar?',
    a: 'En el centro hay cocheras privadas y espacios regulados o limitados en calle. Como disponibilidad y tarifas pueden cambiar, lo más seguro es confirmar al llegar y no dejar objetos visibles dentro del vehículo.',
  },
  {
    q: '¿Dónde se ubica la Plaza de Armas Piura?',
    a: 'Se ubica en el centro histórico de Piura, región Piura, Perú. La referencia de dirección es Ayacucho, Piura 20001, y su Plus Code es R93F+58. Puedes abrir su ubicación en Google Maps.',
  },
  {
    q: '¿Es gratis visitar la Plaza de Armas de Piura?',
    a: 'Sí. Es un espacio público de acceso libre y gratuito. El registro oficial del MINCETUR (ficha N.º 3163) señala acceso libre durante todo el año.',
  },
  {
    q: '¿Qué puntos de interés hay alrededor de la plaza?',
    a: 'Al caminar desde la plaza puedes visitar la Catedral de San Miguel Arcángel (Iglesia Matriz), el MUCEN Piura (calle Huancavelica 346), la Casa Museo Gran Almirante Grau (Jirón Tacna 662) y la Iglesia San Sebastián.',
  },
  {
    q: '¿Cómo llegar a la Plaza de Armas de Piura?',
    a: 'Desde el Óvalo Grau son unos 800 metros de caminata (unos 6 minutos). Desde la Plazuela Merino, aproximadamente 1 kilómetro en taxi o movilidad urbana. Desde la Iglesia San Sebastián se conecta por un circuito histórico de unos 200 metros.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  '@id': `${siteUrl}/#attraction`,
  name: attractionFullName,
  alternateName: [attractionShortName, 'Piura Plaza de Armas', 'Plaza Mayor de Piura', `${attractionShortName}, ${countryName}`],
  description,
  url: canonical,
  image: [
    `${siteUrl}/images/plaza-de-armas-piura-hero.jpg`,
    `${siteUrl}/images/plaza-de-armas-piura-vista.jpg`,
    `${siteUrl}/images/alegoria-a-la-libertad.jpg`,
    `${siteUrl}/images/catedral-de-piura.jpg`,
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `Ayacucho, ${attractionShortName}`,
    addressLocality: cityName,
    addressRegion: stateProvince,
    postalCode,
    addressCountry: countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude,
    longitude,
  },
  hasMap: mapShortUrl,
  sameAs: [mapShortUrl, minceturFicha, govtTourismUrl, peruTravelUrl, mucenUrl],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.3,
    ratingCount: 16985,
    bestRating: 5,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  touristType: ['Plaza histórica', 'Centro histórico', 'Parque urbano'],
  containedInPlace: {
    '@type': 'City',
    name: cityName,
    address: { '@type': 'PostalAddress', addressLocality: cityName, addressRegion: stateProvince, addressCountry: countryCode },
  },
  mainEntityOfPage: { '@id': `${siteUrl}/#webpage` },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Categoría', value: 'Parque urbano (city park)' },
    { '@type': 'PropertyValue', name: 'Elevación', value: '22 m s. n. m.', unitCode: 'MTR' },
    { '@type': 'PropertyValue', name: 'Plus Code', value: plusCode },
  ],
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: `${attractionFullName} — Guía del visitante`,
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: `${siteUrl}/icons/icon-512.png` },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: attractionFullName,
  url: siteUrl,
  publisher: { '@id': `${siteUrl}/#organization` },
};

const webpageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteUrl}/#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'es-PE',
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: { '@id': `${siteUrl}/#attraction` },
  mainEntity: { '@id': `${siteUrl}/#attraction` },
  author: { '@id': `${siteUrl}/#organization` },
  publisher: { '@id': `${siteUrl}/#organization` },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: ogImage,
    caption: ogImageAlt,
    creditText: 'Edward Josué Quevedo Macalupú',
    creator: { '@type': 'Person', name: 'Edward Josué Quevedo Macalupú' },
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    copyrightNotice: '© Edward Josué Quevedo Macalupú · CC BY-SA 4.0',
  },
  datePublished: dateModified,
  dateModified,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${siteUrl}/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: countryName, item: `${siteUrl}/#sobre` },
    { '@type': 'ListItem', position: 3, name: `${cityName}, Región ${stateProvince}`, item: `${siteUrl}/#ubicacion` },
    { '@type': 'ListItem', position: 4, name: attractionFullName, item: `${siteUrl}/#sobre` },
  ],
};

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [organizationJsonLd, websiteJsonLd, webpageJsonLd, breadcrumbJsonLd, attractionJsonLd, faqJsonLd],
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#244433" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="geo.position" content={`${latitude};${longitude}`} />
    <meta name="geo.placename" content={`${attractionFullName}, ${cityName}, ${countryName}`} />
    <meta name="geo.region" content={`${countryCode}-${stateProvince}`} />
    <meta name="ICBM" content={`${latitude}, ${longitude}`} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="es-PE" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={attractionFullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={attractionFullName} />
    <meta name="msapplication-TileColor" content="#244433" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)}></script>
  </head>
  <body>
    <header class="absolute inset-x-0 top-0 z-30 border-b border-white/15 bg-[#14241d]/25 text-white backdrop-blur-md">
      <div class="shell flex h-20 items-center justify-between gap-6">
        <a href="#inicio" aria-label={`${attractionFullName}, inicio`} class="block rounded-md bg-[#fffaf1] px-3 py-2 shadow-sm">
          <img src="/logo.svg" alt={attractionFullName} width="210" height="54" class="h-11 w-auto" />
        </a>
        <nav aria-label="Navegación principal" class="hidden items-center gap-5 text-sm font-bold lg:flex xl:gap-7">
          <a href="#sobre" class="hover:text-[#f4c38d]">Sobre</a>
          <a href="#historia" class="hover:text-[#f4c38d]">Historia</a>
          <a href="#visita" class="hover:text-[#f4c38d]">Visita</a>
          <a href="#alrededores" class="hover:text-[#f4c38d]">Alrededores</a>
          <a href="#mapa" class="hover:text-[#f4c38d]">Mapa</a>
          <a href="#faq" class="hover:text-[#f4c38d]">FAQ</a>
          <a href="#fuentes" class="hover:text-[#f4c38d]">Fuentes</a>
        </nav>
        <a href={mapShortUrl} target="_blank" rel="noopener noreferrer" class="btn border border-white/35 bg-white/10 text-sm text-white hover:bg-white hover:text-[#1d2a24]">Cómo llegar ↗</a>
      </div>
    </header>

    <main id="inicio">
      <section class="relative min-h-[840px] overflow-hidden bg-[#172a20] text-white md:min-h-[900px]">
        <img src={photos.hero.src} alt={photos.hero.alt} width="1280" height="866" fetchpriority="high" class="hero-photo absolute inset-0 h-full w-full object-cover" />
        <div class="hero-mask absolute inset-0"></div>
        <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-[#172a20] to-transparent"></div>
        <div class="shell relative z-10 flex min-h-[840px] items-end pb-20 pt-36 md:min-h-[900px] md:pb-28">
          <div class="max-w-4xl">
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="pill">★ 4,3 · 16.985 reseñas</span>
              <span class="pill">Entrada libre</span>
              <span class="pill">{cityName} · {countryName}</span>
            </div>
            <p class="mb-4 text-sm font-black uppercase tracking-[.22em] text-[#f2c38f]">El corazón cívico de {cityName}</p>
            <h1 class="serif max-w-[13ch] text-[clamp(3.2rem,8.4vw,7.2rem)] leading-[.82] tracking-[-.05em]">
              Plaza de Armas <em class="font-normal text-[#efb26c]">Piura</em>
              <span class="h1-city">({cityName}, {countryName})</span>
            </h1>
            <p class="mb-4 mt-6 max-w-2xl text-base font-medium leading-7 text-white/85 md:text-lg">
              Bienvenido a la <strong class="text-white">Plaza de Armas Piura</strong>, reconocida también como la <strong class="text-white">Plaza de Armas de Piura</strong> —el <em class="not-italic text-[#f2c38f]">Piura Plaza de Armas</em> del centro histórico—. Es el principal espacio cívico de <strong class="text-white">Piura</strong>, en la región <strong class="text-white">Piura</strong>, <strong class="text-white">Perú</strong>.
            </p>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-white/82 md:text-xl">
              Un cuadrado de sombra, memoria y vida cotidiana en pleno centro histórico: tamarindos, arquitectura republicana y la antigua <strong class="text-white">Alegoría a la Libertad</strong> como punto de encuentro.
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#visita" class="btn btn-light">Planear la visita ↓</a>
              <a href={mapShortUrl} target="_blank" rel="noopener noreferrer" class="btn border border-white/35 text-white hover:bg-white/10">Abrir en Google Maps ↗</a>
            </div>
          </div>
        </div>
        <a href={photos.hero.page} target="_blank" rel="noopener noreferrer" class="absolute bottom-5 right-5 z-10 rounded-full bg-black/45 px-3 py-1.5 text-[11px] text-white/80 backdrop-blur-sm">Foto: {photos.hero.credit}</a>
      </section>

      <section id="sobre" class="bg-[#fffaf1] py-24 md:py-32">
        <div class="shell">
          <nav aria-label="Breadcrumb" class="breadcrumb mb-8">
            <a href="/">Inicio</a>
            <span aria-hidden="true">›</span>
            <a href={govtTourismUrl} target="_blank" rel="noopener noreferrer">{countryName}</a>
            <span aria-hidden="true">›</span>
            <a href={govtTourismPortalUrl} target="_blank" rel="noopener noreferrer">Región {stateProvince}</a>
            <span aria-hidden="true">›</span>
            <span>{cityName}</span>
            <span aria-hidden="true">›</span>
            <span aria-current="page">{attractionFullName}</span>
          </nav>
          <div class="grid gap-14 lg:grid-cols-[.9fr_1.1fr]">
            <div>
              <span class="eyebrow">Sobre el lugar</span>
              <h2 class="section-title">Sobre la {attractionFullName}</h2>
              <p class="section-lead">Centro histórico, espacio público y referencia obligada para entender Piura.</p>
            </div>
            <div class="space-y-6 text-lg leading-8 text-[#6e655b]">
              <p>

---
import '../styles/global.css';

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://piuraplazadearmas.com';
const canonical = Astro.site ? new URL('/', Astro.site).href : undefined;

const attractionFullName = 'Plaza de Armas Piura';
const attractionShortName = 'Plaza de Armas de Piura';
const cityName = 'Piura';
const stateProvince = 'Piura';
const countryName = 'Perú';
const countryCode = 'PE';
const postalCode = '20001';
const plusCode = 'R93F+58';
const latitude = -5.1970998;
const longitude = -80.62668;

const mapShortUrl = 'https://maps.app.goo.gl/WAjRRUEwGccZYiKd9';
const mapEmbed = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7067.300021221717!2d-80.62668!3d-5.1970998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x904a107ddd0efae7%3A0xaeb976088d0ea599!2sPlaza%20de%20Armas%20Piura!5e1!3m2!1ses!2spe!4v1789026773647!5m2!1ses!2spe';

const govtTourismUrl = 'https://www.gob.pe/munipiura';
const minceturFicha = 'https://consultasenlinea.mincetur.gob.pe/fichaInventario/index.aspx?cod_Ficha=3163';
const mucenUrl = 'https://mucen.bcrp.gob.pe/mucen/museos/mucen-piura';
const casaMuseoUrl = 'https://museos.cultura.pe/museos/casa-museo-gran-almirante-grau-de-piura';

const title = 'Plaza de Armas Piura: ubicación, historia y visita';
const description = 'Ubica la Plaza de Armas Piura en Ayacucho: mapa, historia de La Pola, acceso según fuentes y visitas separadas a la catedral y museos.';
const ogImage = `${siteUrl}/images/plaza-de-armas-piura-hero.jpg`;
const ogImageAlt = `${attractionFullName} - vista principal en ${cityName}, ${countryName}`;
const ogImageWidth = 1280;
const ogImageHeight = 866;

const dateModified = '2026-10-26';

const photos = {
  hero: {
    src: '/images/plaza-de-armas-piura-hero.jpg',
    alt: `${attractionFullName} - vista principal en ${cityName}, ${countryName}`,
    credit: 'Edward Josué Quevedo Macalupú · 2019-02-04 · CC BY-SA 4.0',
    page: 'https://commons.wikimedia.org/wiki/File:PLAZA_DE_ARMAS_DE_PIURA_-_PIURA.jpg',
  },
  square: {
    src: '/images/plaza-de-armas-piura-vista.jpg',
    alt: `Jardines, bancas y entorno urbano de la ${attractionShortName} en ${cityName}`,
    credit: 'Pitxiquin · 2017-01-24 · CC BY-SA 4.0',
    page: 'https://commons.wikimedia.org/wiki/File:Plaza_de_Armas_de_Piura.jpg',
  },
  cathedral: {
    src: '/images/catedral-de-piura.jpg',
    alt: `Catedral de San Miguel Arcángel junto a la ${attractionShortName}, ${cityName}, ${countryName}`,
    credit: 'Edward Josué Quevedo Macalupú · 2019-02-04 · CC BY-SA 4.0',
    page: 'https://commons.wikimedia.org/wiki/File:CATEDRAL_DE_PIURA_-_PIURA.jpg',
  },
  monument: {
    src: '/images/alegoria-a-la-libertad.jpg',
    alt: `Alegoría a la Libertad, monumento central de la ${attractionShortName}, ${cityName}, ${countryName}`,
    credit: 'Ccotlear · 2021-10-24 · CC BY-SA 4.0',
    page: 'https://commons.wikimedia.org/wiki/File:ALEGORIA_A_LA_LIBERTAD.jpg',
  },
};

const facts = [
  { label: 'Lugar', value: attractionShortName },
  { label: 'Categoría', value: 'Plaza urbana · Arquitectura y Espacios Urbanos' },
  { label: 'Ubicación', value: `Ayacucho, ${cityName} ${postalCode}, ${countryName}` },
  { label: 'Plus Code', value: `${plusCode}, ${cityName}` },
  { label: 'Coordenadas', value: `${latitude.toFixed(5)}, ${longitude.toFixed(5)}` },
  { label: 'Horario en Maps', value: '24 horas · consulta del 26/10/2026' },
  { label: 'Entrada en inventario', value: 'Libre, según MINCETUR' },
  { label: 'Altitud', value: '22 m s. n. m.' },
  { label: 'Google Maps', value: '4,3 / 5 · 17.011 valoraciones · 26/10/2026' },
];

const visitCards = [
  {
    icon: 'S/',
    title: 'Entrada y costo',
    text: 'MINCETUR registra ingreso libre a la plaza. Esa referencia no incluye entradas a museos, templos o servicios, ni sustituye una restricción municipal temporal.',
  },
  {
    icon: '◴',
    title: 'Mejor momento',
    text: 'Para elegir tu hora, revisa la temperatura y las condiciones del día. Lleva agua y protección solar; la sombra de los árboles no cubre necesariamente todo el recorrido.',
  },
  {
    icon: '↻',
    title: 'Arma tu recorrido',
    text: 'Distingue una pausa en la plaza de una visita a las salas del MUCEN o a la Casa Grau. Elige una visita cultural y comprueba su horario antes de añadir otra; no hay una duración que sirva para todos.',
  },
  {
    icon: 'P',
    title: 'Estacionamiento',
    text: 'No hemos comprobado plazas, tarifas ni un estacionamiento turístico específico. Busca un lugar permitido para tu vehículo y acuerda un punto de bajada que no bloquee cruces ni accesos.',
  },
];

const nearby = [
  { distance: 'entorno de la plaza', name: 'Catedral de Piura · Iglesia Matriz', text: 'El inventario turístico sitúa la Iglesia Matriz en el entorno de la plaza. La fachada aparece en nuestra foto de 2019; el acceso al templo, sus celebraciones y la fotografía interior se consultan por separado.', url: minceturFicha },
  { distance: 'visita cultural independiente', name: 'MUCEN Piura', text: 'El museo del Banco Central de Reserva presenta piezas vicús, numismática y arte regional. Su página describe las salas y las opciones para grupos; revisa allí la visita al museo, sin aplicar el horario de la plaza.', url: mucenUrl },
  { distance: 'Jr. Tacna 662', name: 'Casa Museo Gran Almirante Grau', text: 'El directorio del Ministerio de Cultura identifica la casa museo en Jr. Tacna 662, administrada por la Marina de Guerra del Perú. Publica un horario propio con jornadas partidas; compruébalo para la fecha elegida.', url: casaMuseoUrl },
];

const sources = [
  { name: 'MINCETUR — Inventario Nacional de Recursos Turísticos', detail: 'Ficha 3163: identidad, historia, ingreso libre y referencias de acceso. No publica horas de apertura.', url: minceturFicha },
  { name: 'Banco Central de Reserva del Perú', detail: 'MUCEN Piura: colecciones y organización de una visita propia del museo.', url: mucenUrl },
  { name: 'Ministerio de Cultura', detail: 'Casa Museo Gran Almirante Grau: dirección, administración y horario independiente.', url: casaMuseoUrl },
  { name: 'Google Maps', detail: 'Lugar exacto, dirección, valoraciones y horario de la lista observada el 26 de octubre de 2026. Fuente de terceros.', url: mapShortUrl },
];

const faqs = [
  {
    q: '¿La Plaza de Armas de Piura cobra entrada?',
    a: 'La ficha 3163 de MINCETUR registra ingreso libre a la plaza. Museos, templos y servicios cercanos tienen condiciones propias; una visita a la plaza no da acceso automático a esos lugares.',
  },
  {
    q: '¿La plaza está abierta todo el día?',
    a: 'Google Maps mostraba siete días de 24 horas el 26 de octubre de 2026, con advertencias de posibles diferencias por los feriados del 31 de octubre y 1 de noviembre. Es una lista de terceros, no una garantía municipal de acceso, seguridad o servicios. MINCETUR indica visita durante todo el año, pero no horas de apertura.',
  },
  {
    q: '¿Cuánto tiempo necesito para visitarla?',
    a: 'Depende de si buscas una pausa en la plaza, fotografías o entrar a un museo. Comprueba primero el horario de la visita cultural elegida y calcula el desplazamiento desde tu punto real de partida. No se garantiza un circuito completo en un tiempo fijo.',
  },
  {
    q: '¿Qué hay en el centro de la plaza?',
    a: 'Se encuentra la Alegoría a la Libertad, conocida localmente como “La Pola”, un monumento histórico de mármol asociado a la identidad del espacio cívico piurano.',
  },
  {
    q: '¿Qué puedo visitar caminando desde la plaza?',
    a: 'La Iglesia Matriz forma parte del entorno de la plaza. MUCEN Piura y la Casa Museo Gran Almirante Grau son opciones culturales distintas, con sus propias páginas de visita. Elige según tus intereses, horario y necesidades de movilidad; no suponemos un circuito peatonal continuo ya verificado.',
  },
  {
    q: '¿Dónde conviene estacionar?',
    a: 'Esta guía no ha verificado la disponibilidad actual de un estacionamiento específico. Revisa las señales y los lugares permitidos, consulta las condiciones antes de pagar y acuerda una bajada que no obstaculice el paso.',
  },
  {
    q: '¿Dónde se ubica la Plaza de Armas Piura?',
    a: 'Se ubica en el centro histórico de Piura, región Piura, Perú. La referencia de dirección es Ayacucho, Piura 20001, y su Plus Code es R93F+58. Puedes abrir su ubicación en Google Maps.',
  },
  {
    q: '¿Cómo llegar a la Plaza de Armas de Piura?',
    a: 'El inventario MINCETUR incluye rutas de referencia desde Óvalo Grau, Plazuela Merino y San Sebastián. Son estimaciones de una ficha turística: abre el mapa con tu origen, comprueba cruces y estado de las calles, y ajusta la ruta al calor y a tu movilidad; no prometemos sus minutos de viaje.',
  },
  {
    q: '¿Hay un plano o croquis de la Plaza de Armas de Piura?',
    a: 'La plaza sigue el trazado clásico de plaza mayor: un cuadrado arbolado rodeado por la Catedral de San Miguel Arcángel, la Municipalidad Provincial de Piura y comercios del centro. El mapa de Google de esta página sirve para orientarse; no es un plano técnico, de accesibilidad ni una certificación de cada cruce. Abre la ruta desde tu origen y revisa las condiciones actuales.',
  },
  {
    q: '¿Qué es el centro histórico de Piura y qué relación tiene con la plaza?',
    a: 'La plaza permite orientarse por su monumento central y la Iglesia Matriz del entorno. MUCEN Piura y Casa Grau aportan otros contenidos históricos, pero son destinos separados. Usa sus fuentes propias para decidir qué visitar, sin asumir que todos estarán abiertos o serán adecuados para la misma caminata.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteUrl}/#attraction`,
  name: attractionFullName,
  alternateName: [attractionShortName, 'Piura Plaza de Armas', 'Plaza Mayor de Piura', `${attractionShortName}, ${countryName}`],
  description,
  url: canonical,
  image: [
    `${siteUrl}/images/plaza-de-armas-piura-hero.jpg`,
    `${siteUrl}/images/plaza-de-armas-piura-vista.jpg`,
    `${siteUrl}/images/alegoria-a-la-libertad.jpg`,
    `${siteUrl}/images/catedral-de-piura.jpg`,
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `Ayacucho, ${attractionShortName}`,
    addressLocality: cityName,
    addressRegion: stateProvince,
    postalCode,
    addressCountry: countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude,
    longitude,
  },
  hasMap: mapShortUrl,
  sameAs: [mapShortUrl, minceturFicha],
  touristType: ['Plaza histórica', 'Centro histórico', 'Parque urbano'],
  containedInPlace: {
    '@type': 'City',
    name: cityName,
    address: { '@type': 'PostalAddress', addressLocality: cityName, addressRegion: stateProvince, addressCountry: countryCode },
  },
  mainEntityOfPage: { '@id': `${siteUrl}/#webpage` },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Categoría', value: 'Plaza urbana · Arquitectura y Espacios Urbanos' },
    { '@type': 'PropertyValue', name: 'Elevación', value: '22 m s. n. m.', unitCode: 'MTR' },
    { '@type': 'PropertyValue', name: 'Plus Code', value: plusCode },
  ],
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: `${attractionFullName} — Guía del visitante`,
  description: 'Guía turística educativa independiente, no oficial y sin fines de lucro.',
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: `${siteUrl}/icons/icon-512.png` },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: attractionFullName,
  url: siteUrl,
  publisher: { '@id': `${siteUrl}/#organization` },
};

const webpageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteUrl}/#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'es-PE',
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: { '@id': `${siteUrl}/#attraction` },
  mainEntity: { '@id': `${siteUrl}/#attraction` },
  author: { '@id': `${siteUrl}/#organization` },
  publisher: { '@id': `${siteUrl}/#organization` },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: ogImage,
    caption: ogImageAlt,
    creditText: 'Edward Josué Quevedo Macalupú',
    creator: { '@type': 'Person', name: 'Edward Josué Quevedo Macalupú' },
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    copyrightNotice: '© Edward Josué Quevedo Macalupú · 2019-02-04 · CC BY-SA 4.0',
  },
  datePublished: '2026-09-10',
  dateModified,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${siteUrl}/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: countryName, item: `${siteUrl}/#sobre` },
    { '@type': 'ListItem', position: 3, name: `${cityName}, Región ${stateProvince}`, item: `${siteUrl}/#ubicacion` },
    { '@type': 'ListItem', position: 4, name: attractionFullName, item: `${siteUrl}/#sobre` },
  ],
};

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [organizationJsonLd, websiteJsonLd, webpageJsonLd, breadcrumbJsonLd, attractionJsonLd, faqJsonLd],
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#244433" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="geo.position" content={`${latitude};${longitude}`} />
    <meta name="geo.placename" content={`${attractionFullName}, ${cityName}, ${countryName}`} />
    <meta name="ICBM" content={`${latitude}, ${longitude}`} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="es-PE" href={canonical} />}
    {canonical && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={attractionFullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={attractionFullName} />
    <meta name="msapplication-TileColor" content="#244433" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)}></script>
  </head>
  <body>
    <header class="absolute inset-x-0 top-0 z-30 border-b border-white/15 bg-[#14241d]/25 text-white backdrop-blur-md">
      <div class="shell flex h-20 items-center justify-between gap-6">
        <a href="#inicio" aria-label={`${attractionFullName}, inicio`} class="block rounded-md bg-[#fffaf1] px-3 py-2 shadow-sm">
          <img src="/logo.svg" alt={attractionFullName} width="210" height="54" class="h-11 w-auto" />
        </a>
        <nav aria-label="Navegación principal" class="hidden items-center gap-5 text-sm font-bold lg:flex xl:gap-7">
          <a href="#sobre" class="hover:text-[#f4c38d]">Sobre</a>
          <a href="#historia" class="hover:text-[#f4c38d]">Historia</a>
          <a href="#visita" class="hover:text-[#f4c38d]">Visita</a>
          <a href="#alrededores" class="hover:text-[#f4c38d]">Alrededores</a>
          <a href="#mapa" class="hover:text-[#f4c38d]">Mapa</a>
          <a href="#faq" class="hover:text-[#f4c38d]">FAQ</a>
          <a href="#fuentes" class="hover:text-[#f4c38d]">Fuentes</a>
        </nav>
        <a href={mapShortUrl} target="_blank" rel="noopener noreferrer" class="btn border border-white/35 bg-white/10 text-sm text-white hover:bg-white hover:text-[#1d2a24]">Cómo llegar ↗</a>
      </div>
    </header>

    <main id="inicio">
      <section class="relative min-h-[840px] overflow-hidden bg-[#172a20] text-white md:min-h-[900px]">
        <img src={photos.hero.src} alt={photos.hero.alt} width="1280" height="866" fetchpriority="high" class="hero-photo absolute inset-0 h-full w-full object-cover" />
        <div class="hero-mask absolute inset-0"></div>
        <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-[#172a20] to-transparent"></div>
        <div class="shell relative z-10 flex min-h-[840px] items-end pb-20 pt-36 md:min-h-[900px] md:pb-28">
          <div class="max-w-4xl">
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="pill">Google Maps · 4,3 / 5 · 17.011 · 26/10/2026</span>
              <span class="pill">Ingreso libre · ficha MINCETUR</span>
              <span class="pill">{cityName} · {countryName}</span>
            </div>
            <p class="mb-4 text-sm font-black uppercase tracking-[.22em] text-[#f2c38f]">El corazón cívico de {cityName}</p>
            <h1 class="serif max-w-[13ch] text-[clamp(3.2rem,8.4vw,7.2rem)] leading-[.82] tracking-[-.05em]">
              Plaza de Armas <em class="font-normal text-[#efb26c]">Piura</em>
              <span class="h1-city">({cityName}, {countryName})</span>
            </h1>
            <p class="mb-4 mt-6 max-w-2xl text-base font-medium leading-7 text-white/85 md:text-lg">
              La <strong class="text-white">Plaza de Armas Piura</strong> está en el centro histórico de <strong class="text-white">Piura, Perú</strong>. Ubica la plaza en Ayacucho, conoce el monumento de “La Pola” y decide qué visita cultural añadir sin confundir sus horarios con los de este espacio público.
            </p>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-white/82 md:text-xl">
              Un cuadrado de sombra, memoria y vida cotidiana en pleno centro histórico: tamarindos, arquitectura republicana y la antigua <strong class="text-white">Alegoría a la Libertad</strong> como punto de encuentro.
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#visita" class="btn btn-light">Planear la visita ↓</a>
              <a href={mapShortUrl} target="_blank" rel="noopener noreferrer" class="btn border border-white/35 text-white hover:bg-white/10">Abrir en Google Maps ↗</a>
            </div>
          </div>
        </div>
        <a href={photos.hero.page} target="_blank" rel="noopener noreferrer" class="absolute bottom-5 right-5 z-10 rounded-full bg-black/45 px-3 py-1.5 text-[11px] text-white/80 backdrop-blur-sm">Foto: {photos.hero.credit}</a>
      </section>

      <section id="sobre" class="bg-[#fffaf1] py-24 md:py-32">
        <div class="shell">
          <nav aria-label="Breadcrumb" class="breadcrumb mb-8">
            <a href="/">Inicio</a>
            <span aria-hidden="true">›</span>
            <a href={govtTourismUrl} target="_blank" rel="noopener noreferrer">{countryName}</a>
            <span aria-hidden="true">›</span>
            <a href={minceturFicha} target="_blank" rel="noopener noreferrer">Región {stateProvince}</a>
            <span aria-hidden="true">›</span>
            <span>{cityName}</span>
            <span aria-hidden="true">›</span>
            <span aria-current="page">{attractionFullName}</span>
          </nav>
          <div class="grid gap-14 lg:grid-cols-[.9fr_1.1fr]">
            <div>
              <span class="eyebrow">Sobre el lugar</span>
              <h2 class="section-title">Sobre la {attractionFullName}</h2>
              <p class="section-lead">Una plaza arbolada para orientarse y observar la memoria cívica de Piura.</p>
            </div>
            <div class="space-y-6 text-lg leading-8 text-[#6e655b]">
              <p>
                La <strong class="text-[#1d2a24]">{attractionShortName}</strong> es una plaza del centro de Piura descrita en el inventario turístico como un espacio arbolado de tradición española. El monumento central y la Iglesia Matriz ayudan a reconocer su entorno; el mapa ubica el lugar en Ayacucho, Piura 20001.
              </p>
              <p>
                Para añadir contenido cultural, consulta las salas del <a href={mucenUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#b9633e] underline">MUCEN Piura</a> o la <a href={casaMuseoUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#b9633e] underline">Casa Museo Gran Almirante Grau</a>. Cada institución organiza su propia visita. La foto histórica de la catedral muestra su fachada, no un horario de entrada al templo.
              </p>
              <p class="text-base">
